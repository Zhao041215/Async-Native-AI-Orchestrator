{
  "schema_version": "1.0.0",
  "kind": "connector-hooks",
  "repository_state": "not_repo",
  "hooks": {
    "github_pull_request": {
      "ready": false,
      "recommended_input_fields": [
        "title",
        "body",
        "labels",
        "base_branch",
        "head_branch"
      ],
      "requires_human_review": true
    },
    "gitlab_merge_request": {
      "ready": false,
      "recommended_input_fields": [
        "title",
        "description",
        "labels",
        "target_branch",
        "source_branch"
      ],
      "requires_human_review": true
    }
  }
}