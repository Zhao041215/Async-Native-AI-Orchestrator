{
  "schema_version": "1.0.0",
  "kind": "productionization-scaffold",
  "identity_boundary": {
    "mode": "single-local-operator",
    "user_header": "X-Local-User",
    "default_user": "local-user",
    "tenant_mode": "single-tenant",
    "default_tenant": "local-workspace",
    "future_ready": false
  },
  "queue_boundary": {
    "queue_mode": "in_process",
    "queue_backend": "in-process",
    "worker_model": "same-process-thread",
    "future_ready": false
  },
  "sandbox_boundary": {
    "sandbox_mode": "role-governed-local",
    "max_shell_seconds": 120,
    "governed": true,
    "future_ready": false
  },
  "deployment_scaffold": {
    "deployment_mode": "local-single-user",
    "deployment_target": "local-dev",
    "diagnostics_enabled": true,
    "future_auth_enabled": false
  },
  "operational_diagnostics": {
    "logs_path": "E:\\ProgramProjects\\AI_Agent\\logs",
    "workspace_root": "E:\\ProgramProjects\\AI_Agent\\workspace\\projects",
    "db_path": "E:\\ProgramProjects\\AI_Agent\\workspace\\orchestrator.db",
    "diagnostics_enabled": true,
    "hosted_execution_ready": false
  }
}